# Секреты WebDAV. Копируется в /app/.backup-webdav.env (chmod 600).
# Не коммитить файл с паролем.

WEBDAV_URL=https://wd.alekan.keenetic.pro:8443/NAS/Backup/dogodoc
WEBDAV_USER=backup
WEBDAV_PASSWORD=

# Пароль шифрования архива (AES-256). На NAS/в облако уходит только .tar.gz.enc.
# Тот же пароль нужен при восстановлении. Не хранить на NAS.
ARCHIVE_PASSWORD=
