# База данных
DATABASE_URL=postgresql://dogovora:СЮДА_ПАРОЛЬ@db:5432/dogovora
POSTGRES_PASSWORD=СЮДА_ПАРОЛЬ

# Redis
REDIS_URL=redis://redis:6379

# JWT (сгенерировать: openssl rand -hex 64)
JWT_SECRET=СЮДА_СЕКРЕТ
JWT_REFRESH_SECRET=СЮДА_СЕКРЕТ_2

# ИИ: fallback из ENV, если админка /admin/ai ещё пуста.
# После настройки операторов и маршрутов в БД — приоритет у админки.
# Значения: gigachat | polza | openrouter | mock
AI_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=СЮДА_КЛЮЧ_GIGACHAT
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Polza.ai (если используете вместо/вместе с GigaChat через маршруты)
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Dogodok
# Шифрование ключей ИИ в БД (≥32 символов; иначе используется JWT_SECRET)
AI_CREDENTIALS_ENCRYPTION_KEY=
OPENAI_API_KEY=

# Next.js
NODE_ENV=production
NEXTAUTH_URL=https://app.dogodoc.ru

# Технические логи (ротация): app.log + error.log
# В Docker каталог смонтирован как ./logs → /app/logs
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_PROJECT=dogovora
LOG_SERVICE=web
LOG_ENV=production
