generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Пользователь ────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String?
  businessScope String?
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profiles           Profile[]
  oauthAccounts      OAuthAccount[]
  wallet             Wallet?
  storageQuota       StorageQuota?
  counterparties     Counterparty[]
  documents          Document[]
  documentTemplates  DocumentTemplate[]
  usedPromoCode      PromoCode?
  consents           UserConsent[]

  @@map("users")
}

// ─── Согласия пользователя (152-ФЗ) ──────────────────────────────────────────
// APPEND-ONLY: записи никогда не обновляются и не удаляются.
// Отзыв согласия = новая запись с granted = false.
// Хранит доказательство: какую редакцию документа человек принял, когда, с какого IP.

model UserConsent {
  id         String      @id @default(cuid())
  userId     String
  kind       ConsentKind
  granted    Boolean     @default(true)
  docVersion String // редакция документа на момент акцепта, напр. "2026-08-03"
  source     String      @default("registration") // registration | settings | api
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("user_consents")
}

enum ConsentKind {
  OFFER // публичная оферта + пользовательское соглашение
  PDN // согласие на обработку персональных данных
  CROSS_BORDER // согласие на трансграничную передачу ПДн (ст. 12 152-ФЗ)
  MARKETING // рекламные и информационные рассылки (необязательное)
}

// Для будущего OAuth (Госуслуги / Яндекс ID) — таблица пустая в MVP
model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String  // "gosuslugi" | "yandex"
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

// ─── Реквизиты пользователя ───────────────────────────────────────────────────

model Profile {
  id             String      @id @default(cuid())
  userId         String
  type           ProfileType
  name           String
  inn            String?
  kpp            String?
  ogrn           String?
  // Дата регистрации ОГРН/ОГРНИП — для строки «ОГРНИП … от … г.» в преамбуле.
  // Форма реквизитов собирала её всегда; колонка появилась позже формы.
  ogrnDate       String?
  legalAddress   String?
  // Email профиля — попадает в блок реквизитов документа
  email          String?
  // Подписант от имени этого профиля
  signatorName   String?
  signatorPosition String?
  signatorBasis  String?
  // Файлы факсимиле и печати (пути в S3)
  signatureFilePath String?
  stampFilePath  String?
  // Шаблон номера договора для этого юрлица, например "{NNN}/{ММ}-{ГГ}".
  // null или пустая строка — нумерация не настроена, номер вводится свободно.
  contractNumberFormat String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankDetails BankDetail[]
  documents   Document[]

  @@map("profiles")
}

enum ProfileType {
  INDIVIDUAL        // Физлицо
  SOLE_PROPRIETOR   // ИП
  COMPANY           // ООО / АО
  ANO               // АНО (Автономная Некоммерческая Организация)
  PAO               // ПАО (Публичное Акционерное Общество)
  ZAO               // ЗАО (Закрытое Акционерное Общество)
}

// ─── Контрагенты ─────────────────────────────────────────────────────────────

model Counterparty {
  id           String   @id @default(cuid())
  userId       String
  name         String
  inn          String?
  kpp          String?
  ogrn         String?
  legalAddress String?
  email        String?
  phone        String?
  // Контактные лица (до 3): [{ role, name?, email, phone }] — форма в карточке
  // контрагента существовала всегда, но поле в БД появилось позже, и PUT падал 500.
  contacts     Json?
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankDetails BankDetail[]
  signatories Signatory[]
  documents   Document[]

  @@map("counterparties")
}

model BankDetail {
  id                  String  @id @default(cuid())
  profileId           String?
  counterpartyId      String?
  bankName            String
  bik                 String
  checkingAccount     String
  correspondentAccount String

  profile      Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@map("bank_details")
}

model Signatory {
  id             String          @id @default(cuid())
  counterpartyId String
  fullName       String
  signatureName  String
  position       String
  basisType      SignatoryBasis
  poaNumber      String?
  poaDate        DateTime?
  poaExpiry      DateTime?
  poaFilePath    String?
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())

  counterparty Counterparty     @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  scopes       SignatoryScope[]

  @@map("signatories")
}

model SignatoryScope {
  id          String        @id @default(cuid())
  signatoryId String
  scope       DocumentScope

  signatory Signatory @relation(fields: [signatoryId], references: [id], onDelete: Cascade)

  @@unique([signatoryId, scope])
  @@map("signatory_scopes")
}

enum SignatoryBasis {
  CHARTER     // Устав
  POA         // Доверенность
  CERTIFICATE // Свидетельство
  REGULATION  // Положение
  OTHER       // Иное
}

enum DocumentScope {
  CONTRACT   // Договор
  APPENDIX   // Приложение
  AMENDMENT  // Доп. соглашение
  ACT        // Акт
}

// ─── Документы и версии ───────────────────────────────────────────────────────

model Document {
  id               String       @id @default(cuid())
  userId           String
  counterpartyId   String
  title            String
  number           String?
  type             DocumentType
  // Иерархия: для APPENDIX и AMENDMENT — ссылка на родительский CONTRACT
  parentDocumentId String?
  documentNumber   Int?         // порядковый номер приложения/ДС (1, 2, 3...)
  profileId        String?      // профиль пользователя (моя компания) выбранный при создании
  signingDate      DateTime?    // плановая дата подписания (задаётся при создании)
  signedAt         DateTime?    // дата фактического подписания (устанавливается при переводе в SIGNED)
  // Шапка и блок реквизитов/подписей, согласованные пользователем при создании
  // документа (мастер строит их из ЛК и разрешает править вручную).
  // Источник истины для генерации, предпросмотра и выгрузки в Word.
  preambleHtml     String?
  requisitesHtml   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  profile        Profile?     @relation(fields: [profileId], references: [id])
  versions       Version[]
  parentDocument Document?    @relation("DocumentHierarchy", fields: [parentDocumentId], references: [id])
  childDocuments Document[]   @relation("DocumentHierarchy")

  // Нумерация договоров: расчёт следующего номера выбирает номера одного
  // юрлица, проверка дубля ищет точное совпадение в том же скоупе.
  @@index([userId, profileId, number])
  @@map("documents")
}

// ВАЖНО: версии — append-only. Текст/файл никогда не обновляется.
model Version {
  id         String        @id @default(cuid())
  documentId String
  number     Int
  status     VersionStatus @default(DRAFT)
  filePath   String?       // путь в S3
  fileSize   Int?          // байты
  content    String?       // текст документа (до подключения S3)
  formattedContent String?  // отформатированный DOCX/JSON контент
  formattingApplied Boolean? @default(false) // флаг: применено ли форматирование
  parentDocumentId String?   // для приложений/допсоглащений: ссылка на родительский договор
  documentNumber Int?        // номер приложения/допсоглащения (1, 2, 3...)
  aiSettings Json            // { protectionLevel, targetSize, customInstruction }
  createdAt  DateTime        @default(now())

  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]
  purchase     Purchase?
  transactions Transaction[]

  @@unique([documentId, number])
  @@map("versions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  versionId String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// Покупка версии — создаётся один раз, идемпотентна
model Purchase {
  id          String   @id @default(cuid())
  versionId   String   @unique
  amount      Decimal  @db.Decimal(10, 2)
  purchasedAt DateTime @default(now())

  version Version @relation(fields: [versionId], references: [id])

  @@map("purchases")
}

enum DocumentType {
  CONTRACT   // Договор
  APPENDIX   // Приложение
  AMENDMENT  // Доп. соглашение
}

enum VersionStatus {
  DRAFT        // Черновик
  IN_PROGRESS  // В работе
  REVIEW       // На проверке
  APPROVED     // Утверждено
  PAID         // Оплачено
  SIGNED       // Подписан
}

enum ChatRole {
  USER
  AI
  WARNING
}

// ─── Финансы ─────────────────────────────────────────────────────────────────

model Wallet {
  id      String  @id @default(cuid())
  userId  String  @unique
  balance Decimal @default(0) @db.Decimal(10, 2)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id               String          @id @default(cuid())
  walletId         String
  type             TransactionType
  amount           Decimal         @db.Decimal(10, 2)
  description      String
  relatedVersionId String?
  createdAt        DateTime        @default(now())

  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  relatedVersion Version? @relation(fields: [relatedVersionId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  CREDIT  // Пополнение
  DEBIT   // Списание
}

// ─── Шаблоны документов ───────────────────────────────────────────────────────

model DocumentTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String   // DOCX или plain text шаблон
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("document_templates")
}

// ─── Промокоды (доступ к бета-тестированию) ──────────────────────────────────

model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  isActive  Boolean  @default(true)
  usedById  String?  @unique  // одноразовый — один пользователь
  usedAt    DateTime?
  createdAt DateTime @default(now())

  usedBy User? @relation(fields: [usedById], references: [id])

  @@map("promo_codes")
}

// ─── Аудит входов (безопасность) ─────────────────────────────────────────────
// Лог попыток входа/выхода для обнаружения и расследования атак. Без relation к
// User: фиксируем и несуществующие email (попытки перебора), userId опционален.

model LoginAudit {
  id        String   @id @default(cuid())
  email     String   // email из попытки входа (в нижнем регистре)
  userId    String?  // заполняется при успешном входе/известном пользователе
  ip        String?
  userAgent String?
  result    String   // SUCCESS | FAIL | LOCKED | LOGOUT
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_audits")
}

// ─── Хранилище ────────────────────────────────────────────────────────────────

model StorageQuota {
  id        String      @id @default(cuid())
  userId    String      @unique
  usedBytes BigInt      @default(0)
  limitBytes BigInt     @default(524288000) // 500 MB по умолчанию
  plan      StoragePlan @default(STARTER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("storage_quotas")
}

enum StoragePlan {
  STARTER  // Старт
  BUSINESS // Дело
  BUREAU   // Бюро
}

// ─── Конфигурация ИИ (админ) ─────────────────────────────────────────────────

/// Оператор ИИ: Polza.ai, OpenRouter, GigaChat и др.
model AIOperator {
  id          String   @id @default(cuid())
  slug        String   @unique // "polza" | "gigachat" | "mock"
  name        String
  isEnabled   Boolean  @default(true)
  /// Зашифрованный JSON с ключами (apiKey, authKey, scope, baseUrl...)
  credentials String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskRoutes AITaskRoute[]
  usageLogs  AIUsageLog[]

  @@map("ai_operators")
}

/// Маршрут: задача → оператор + модель. task="default" — запасной маршрут.
model AITaskRoute {
  id             String   @id @default(cuid())
  task           String   @unique
  operatorId     String
  modelId        String
  temperature    Float    @default(0.7)
  maxTokens      Int?
  /// JSON: Polza provider policy { sort, only, ignore, allow_fallbacks }
  providerPolicy String?
  isEnabled      Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  operator AIOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@map("ai_task_routes")
}

/// Лог запросов к ИИ — для дашборда расходов в админке.
model AIUsageLog {
  id               String   @id @default(cuid())
  operatorId       String
  task             String
  modelId          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costRub          Float?
  durationMs       Int      @default(0)
  versionId        String?
  userId           String?
  createdAt        DateTime @default(now())

  operator AIOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([task])
  @@map("ai_usage_logs")
}
