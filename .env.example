# База данных
DATABASE_URL="postgresql://dogovora:dogovora_secret@localhost:5433/dogovora_dev"

# Redis
REDIS_URL="redis://localhost:6380"
WORKER_CONCURRENCY=1

# JWT
JWT_SECRET="замени-на-случайную-строку-минимум-32-символа"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Файловое хранилище (бинарные файлы: DOCX/PDF/сканы)
# Бинари лежат в каталогах на диске, в БД хранится только путь.
# В production задавайте абсолютный путь к примонтированному volume, напр. /var/dogovora/storage
STORAGE_DIR="storage"

# S3 / Файлы (НЕ используется — оставлено на будущее, если перейдём на объектное хранилище)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_BUCKET="dogovora-files"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ru-central1"

# ИИ провайдер (mock, gigachat, codex, claude или openai)
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GIGACHAT_AUTH_KEY=""
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
GIGACHAT_MODEL="GigaChat-2-Max"
GIGACHAT_BASE_URL="https://gigachat.devices.sberbank.ru/api/v1"
GIGACHAT_AUTH_URL="https://ngw.devices.sberbank.ru:9443/api/v2/oauth"

# Codex CLI — только для локального тестирования, не для production
CODEX_CLI_COMMAND="codex"
CODEX_MODEL=""
CODEX_PROFILE=""
CODEX_WORKDIR=""
CODEX_TIMEOUT_MS=180000

# Приложение
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT=3001
WEB_PORT=3000

# Окружение
NODE_ENV="development"
