# База данных
DATABASE_URL="postgresql://dogovora:dogovora_secret@localhost:5433/dogovora_dev"

# Redis
REDIS_URL="redis://localhost:6380"
WORKER_CONCURRENCY=1

# JWT (TTL токенов зашит в коде: access 15 мин, refresh 30 дней — см. lib/auth.ts)
JWT_SECRET="замени-на-случайную-строку-минимум-32-символа"

# Куки авторизации: false — отключить флаг Secure (например, прод без HTTPS)
COOKIE_SECURE=true

# Файловое хранилище (бинарные файлы: DOCX/PDF/сканы)
# Бинари лежат в каталогах на диске, в БД хранится только путь.
# В production задавайте абсолютный путь к примонтированному volume, напр. /var/dogovora/storage
STORAGE_DIR="storage"

# ИИ провайдер (mock, gigachat, polza, openrouter)
AI_PROVIDER="mock"

# Polza.ai — агрегатор моделей (OpenAI-совместимый API)
POLZA_API_KEY=""
POLZA_BASE_URL="https://polza.ai/api/v1"

# OpenRouter — агрегатор моделей (OpenAI-совместимый API)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Опционально: заголовки для рейтинга на openrouter.ai
OPENROUTER_HTTP_REFERER=""
OPENROUTER_APP_TITLE="Dogodok"

# Модели по задачам (резерв, если админка пуста). После настройки в /admin/ai — из БД.
AI_MODEL_DEFAULT="openai/gpt-4o-mini"
AI_MODEL_GENERATE="anthropic/claude-sonnet-4-5"
AI_MODEL_EDIT="openai/gpt-4o"
AI_MODEL_CHAT="openai/gpt-4o-mini"
AI_MODEL_QUICK_ANALYSIS="openai/gpt-4o"
AI_MODEL_REVIEW="anthropic/claude-sonnet-4-5"
AI_MODEL_ANALYZE_UPLOAD="anthropic/claude-sonnet-4-5"
AI_MODEL_SPELLING="openai/gpt-4o-mini"
AI_MODEL_REVIEW_FALLBACK="openai/gpt-4o-mini"
AI_MODEL_EXTRACT_PARTIES="openai/gpt-4o"

# Шифрование ключей ИИ в БД (≥32 символов; по умолчанию JWT_SECRET)
AI_CREDENTIALS_ENCRYPTION_KEY=""

OPENAI_API_KEY=""
GIGACHAT_AUTH_KEY=""
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
GIGACHAT_MODEL="GigaChat-2-Max"
GIGACHAT_REVIEW_MODEL="GigaChat-2-Max"
GIGACHAT_FAST_MODEL="GigaChat-2"
GIGACHAT_BASE_URL="https://gigachat.devices.sberbank.ru/api/v1"
GIGACHAT_AUTH_URL="https://ngw.devices.sberbank.ru:9443/api/v2/oauth"

# Окружение
NODE_ENV="development"

# Токеновая экономика (предоплата, см. apps/web/src/lib/token-pricing.ts)
# Цены действий в токенах
TOKEN_PRICE_GENERATE=100
TOKEN_PRICE_UPLOAD_EDIT_START=50
TOKEN_PRICE_REWRITE=100
TOKEN_PRICE_EDIT_PACKAGE=100
TOKEN_PRICE_REVIEW=25
TOKEN_PRICE_ANALYZE_UPLOAD=25
# Сколько ИИ-правок даёт один пакет
TOKEN_EDITS_PER_PACKAGE=10
# Стартовый бонус при регистрации, токенов
WELCOME_BONUS_TOKENS=500

# Лимиты ИИ и защита от злоупотреблений
# Сообщений чата в минуту на пользователя
CHAT_RATE_PER_MIN=15
# Проверок документа за 10 минут на пользователя
REVIEW_RATE_PER_10MIN=10
# Анализов загруженного документа за 10 минут на пользователя
ANALYZE_RATE_PER_10MIN=10
# Извлечений сторон за 10 минут на пользователя
EXTRACT_RATE_PER_10MIN=15
# Максимальный размер текста для анализа, символов
MAX_ANALYZE_TEXT_CHARS=400000

# Технические логи в файлы: logs/app.log + logs/error.log
# В Docker: LOG_DIR=/app/logs → ./logs на хосте
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
# 10 МБ × 10 бэкапов
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Для единого контракта error.log (JSONL): project/service/env
LOG_PROJECT=dogovora
LOG_SERVICE=web
LOG_ENV=development

# Интернет-эквайринг Т-Банка (пополнение баланса токенов)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2/
PUBLIC_BASE_URL=https://app.dogodoc.ru
TBANK_TAXATION=usn_income
TBANK_VAT=none
# Необязательно — переопределение цен пакетов в рублях:
# TOKEN_PACKAGE_START_RUB=300
# TOKEN_PACKAGE_STANDARD_RUB=900
# TOKEN_PACKAGE_PRO_RUB=2500
# TOKEN_PACKAGE_MAX_RUB=7900
